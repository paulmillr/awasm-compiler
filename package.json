{
  "name": "@awasm/compiler",
  "version": "0.1.3",
  "description": "Auditable js-to-wasm compiler, focusing on ultra-high performance & security",
  "files": [
    "src",
    "*.js",
    "*.d.ts"
  ],
  "dependencies": {
    "@scure/base": "2.3.0",
    "micro-packed": "0.9.0"
  },
  "devDependencies": {
    "@paulmillr/jsbt": "0.7.0",
    "bismar": "0.1.8",
    "fast-check": "4.2.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "scripts": {
    "benchmark:size": "bismar -bsm",
    "build": "tsc",
    "build:clean": "rm *.{js,d.ts} 2> /dev/null",
    "check": "jsbt-check",
    "format": "prettier --write 'src/**/*.{js,ts}' 'test/**/*.{js,ts,mjs}'",
    "test": "node test/index.ts"
  },
  "exports": {
    "./codegen.js": "./codegen.js",
    "./js.js": "./js.js",
    "./memory.js": "./memory.js",
    "./module.js": "./module.js",
    "./rewrites.js": "./rewrites.js",
    "./runtime.js": "./runtime.js",
    "./types.js": "./types.js",
    "./wasm.js": "./wasm.js",
    "./workers.js": "./workers.js",
    "./utils.js": "./utils.js"
  },
  "engines": {
    "node": ">= 22.22.0"
  },
  "keywords": [
    "awasm",
    "wasm",
    "compiler",
    "transpiler",
    "webassembly",
    "parallel",
    "threaded",
    "auditable",
    "noble",
    "cryptography"
  ],
  "funding": "https://paulmillr.com/funding/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulmillr/awasm-compiler.git"
  },
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "author": "Paul Miller (https://paulmillr.com)",
  "license": "MIT"
}
