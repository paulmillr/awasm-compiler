{
  "extends": "@paulmillr/jsbt/tsconfig.json",
  "compilerOptions": {
    "outDir": ".",
    // TypeScript 6 requires this when outDir is the package root and sources live in src.
    "rootDir": "src",
    "isolatedDeclarations": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}
